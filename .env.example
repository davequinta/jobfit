# jobfit environment. Copy to .env and fill in.
#
# `jobfit init` writes this file for you. It is gitignored — never commit it.
# Nothing here leaves your machine except JOBFIT_CONTACT, which is sent to the
# job feeds in the User-Agent header so they can reach a human.


# ── Required for stage 1 (ingest) ────────────────────────────────────────────

# An address the feeds you crawl can contact you at. It is appended to the
# User-Agent on every request. Use one you are happy for those sites to see.
# Leave it unset and ingest still runs, but it logs a warning and identifies
# itself with no way to reach you — which is rude, and this repo is public.
JOBFIT_CONTACT=you@example.com


# ── Required for stage 3 (score) ─────────────────────────────────────────────

# Get one at https://console.anthropic.com → Settings → API keys.
# Starts with "sk-ant-".
#
# IMPORTANT: a Claude Code or Claude.ai subscription is NOT API access. They are
# separate accounts with separate billing. You need a key with credit on it.
#
# Stages 1, 2 and the queue cost nothing and do not read this. Only `jobfit
# score` calls the API — expect roughly $0.05–$0.35 per run depending on model
# and how many postings clear your prefilter.
ANTHROPIC_API_KEY=
